# Copy to .env and fill in, or keep the secrets in Infisical and start with
# `infisical run -- docker compose up -d`. Generate secrets with: openssl rand -hex 24
POSTGRES_PASSWORD=
RUNNER_TOKEN=
# noVNC password for the browser view (VNC uses only the first 8 characters)
VNC_PASSWORD=
# Optional extra password for the dashboard on your home network
DASHBOARD_PASSWORD=
# Your timezone; the sending schedule follows it
TZ=Asia/Karachi
BROWSER_LOCALE=en-US
DASHBOARD_PORT=3080
NOVNC_PORT=6080
# Link shown on the dashboard for the browser view, e.g. https://browser.example.com/vnc.html
NOVNC_PUBLIC_URL=
# Only needed with the tunnel profile
CF_TUNNEL_TOKEN=
# Data folders (defaults are ./data/...). On the NAS:
DB_DIR=/volume1/docker/linkedauto/db
BROWSER_PROFILE_DIR=/volume1/docker/linkedauto/browser-profile
BACKUP_DIR=/volume1/docker/linkedauto/backups
